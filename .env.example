# Supabase - pegue em Project Settings > API do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# EFI Pay - https://dev.efipay.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=./certs/producao-certificado.pem
EFI_PIX_KEY=
EFI_SANDBOX=true
# Segredo que vai na URL do webhook (?hmac=...). Gere um valor longo e aleatório,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EFI_WEBHOOK_SECRET=

# Só para testes: libera o PIX simulado em build de produção. Nunca use no site real.
ALLOW_PIX_MOCK=false

# Painel /admin - protegido por Basic Auth simples
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
