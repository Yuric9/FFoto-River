# Supabase - pegue em Project Settings > API do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Fotos no Cloudflare R2 (ou qualquer storage compatível com S3)
# Painel da Cloudflare > R2 > Manage API tokens: crie um token com "Object Read & Write"
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_ORIGINAIS=ffoto-originais
S3_BUCKET_PROVAS=ffoto-provas
# Domínio público do bucket de prévias (R2 > ffoto-provas > Settings > Public access)
NEXT_PUBLIC_PREVIEWS_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Endereço público do site (usado para cadastrar o webhook na EFI). Precisa ser https.
SITE_URL=https://seu-site.vercel.app

# EFI Pay - https://dev.efipay.com.br
# Sem estas variáveis, o checkout usa um PIX SIMULADO (só funciona em desenvolvimento).
EFI_SANDBOX=true
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
# Certificado (.p12) baixado no painel da EFI. Use UMA das opções:
# 1) No seu computador: caminho do arquivo (a pasta certs/ está no .gitignore)
EFI_CERTIFICATE_PATH=./certs/homologacao.p12
# 2) Na Vercel: o arquivo em base64 (veja o README)
EFI_CERTIFICATE_BASE64=
# Senha do certificado (os da EFI normalmente não têm: deixe vazio)
EFI_CERTIFICATE_PASSPHRASE=

# Segredo que vai na URL do webhook (?hmac=...). Mínimo de 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EFI_WEBHOOK_SECRET=

# Só para testes: libera o PIX simulado em build de produção. Nunca use no site real.
ALLOW_PIX_MOCK=false

# Painel /admin - protegido por Basic Auth simples
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
